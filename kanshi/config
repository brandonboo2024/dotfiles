# Profiles for every machine. kanshi picks the one matching the connected
# outputs, so machines cannot collide.

profile prometheus-internal {
        output eDP-1 {
               mode 3200x2000@165
               position 0,0
               scale 1
               }
}

profile prometheus-dual {
        output eDP-1 {
               mode 3200x2000@165
               position 0,0
               scale 1
        }
        output HDMI-A-1 {
               mode 1920x1080@180
               position 3200,0
               scale 1
        }
}

profile hephaestus-dual {
        output DP-4 {
               mode 2560x1440@165
               position 0,0
               scale 1
               }

        output HDMI-A-2 {
               mode 1920x1080@180
               position 2560,0
               scale 1
               }
}

profile hephaestus-dual-hdmi1 {
        output DP-4 {
               mode 2560x1440@165
               position 0,0
               scale 1
               }

        output HDMI-A-1 {
               mode 1920x1080@180
               position 2560,0
               scale 1
               }
}

profile hephaestus-single {
        output DP-4 {
               mode 2560x1440@165
               position 0,0
               scale 1
               }
}

profile desktop_single {
        output HDMI-A-2 {
               mode 1920x1080@180
               position 2560,0
               scale 1
               }
}
