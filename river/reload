#!/bin/sh

# River configuration reference:
# https://mylinux.work/guides/river-compositor-setup/

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
# shellcheck source=/dev/null
. "$config_home/river/environment"

# Shared pointer behavior for touchpads and external mice.
riverctl input "$POINTER_PATTERN" natural-scroll enabled
riverctl input "$POINTER_PATTERN" accel-profile flat
riverctl input "$POINTER_PATTERN" pointer-accel 1.0
riverctl input "$POINTER_PATTERN" drag enabled
riverctl input "$POINTER_PATTERN" tap enabled

# Per-host exceptions, newline separated (see river/hosts/*.sh).
for device in $NATURAL_SCROLL_DISABLE_PATTERNS; do
    riverctl input "$device" natural-scroll disabled
done

riverctl set-cursor-warp on-focus-change
riverctl xcursor-theme Bibata-Modern-Ice "$CURSOR_SIZE"
riverctl focus-follows-cursor normal

# Core keybinds. Both Emacs bindings attach to the one daemon:
#   Super+E             GUI Emacs frame
#   Super+Return        terminal
#   Super+Shift+Return  Emacs in a terminal
riverctl map normal Super E spawn "emacsclient -c"
riverctl map normal Super Return spawn footclient
riverctl map normal Super+Shift Return spawn "footclient -e emacsclient -nw"
riverctl map normal Super B spawn firefox
riverctl map normal Super Space spawn fuzzel
riverctl map normal Super Q close
riverctl map normal Super+Shift E exit
riverctl map normal Super+Shift R spawn "$config_home/river/reload"
riverctl map normal Super P spawn open-pdf
riverctl map normal Super A spawn agent-session
riverctl map normal Super C spawn org-capture-quick
riverctl map normal Super M spawn audio-menu
riverctl map normal None F10 spawn power-menu
riverctl map normal None F12 spawn screenshot-full
riverctl map normal Super+Shift S spawn screenshot-region
riverctl map normal Super V spawn cliphist-fuzzel-img
# Deferred expansion: riverctl passes these commands to `sh -c` on keypress.
# shellcheck disable=SC2016
bar_signal='pidfile="${XDG_RUNTIME_DIR:-/tmp}/status-bar.pid"; [ -r "$pidfile" ] && kill -USR1 "$(cat "$pidfile")" 2>/dev/null || true'
riverctl map normal Super Escape spawn "networkmanager_dmenu; $bar_signal"
riverctl map normal Super+Shift Escape spawn bt-menu
riverctl map normal Super Tab focus-previous-tags
riverctl map normal Super Z zoom

# Fnott notification controls. Actions are selected with the Fuzzel helper
# configured in fnott/fnott.ini.
riverctl map normal Super N spawn "fnottctl dismiss"
riverctl map normal Super+Shift N spawn "fnottctl dismiss all"
riverctl map normal Super+Control N spawn "fnottctl actions"

# Super+J and Super+K to focus the next/previous view in the layout stack
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous

# Super+Shift+J and Super+Shift+K to swap the focused view with the next/previous
# view in the layout stack
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

# Super+Period and Super+Comma to focus the next/previous output
riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous

# Super+Shift+{Period,Comma} to send the focused view to the next/previous output
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

# Super+H and Super+L to decrease/increase the main ratio of rivertile(1)
riverctl map normal Super H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super L send-layout-cmd rivertile "main-ratio +0.05"

# Super+I and Super+Shift+I to increment/decrement the main count of rivertile(1)
riverctl map normal Super I send-layout-cmd rivertile "main-count +1"
riverctl map normal Super+Shift I send-layout-cmd rivertile "main-count -1"

# Super+Alt+{H,J,K,L} to move views
riverctl map normal Super+Alt H move left 100
riverctl map normal Super+Alt J move down 100
riverctl map normal Super+Alt K move up 100
riverctl map normal Super+Alt L move right 100

# Super+Alt+Control+{H,J,K,L} to snap views to screen edges
riverctl map normal Super+Alt+Control H snap left
riverctl map normal Super+Alt+Control J snap down
riverctl map normal Super+Alt+Control K snap up
riverctl map normal Super+Alt+Control L snap right

# Super+Alt+Shift+{H,J,K,L} to resize views
riverctl map normal Super+Alt+Shift H resize horizontal -100
riverctl map normal Super+Alt+Shift J resize vertical 100
riverctl map normal Super+Alt+Shift K resize vertical -100
riverctl map normal Super+Alt+Shift L resize horizontal 100

# Super + Left Mouse Button to move views
riverctl map-pointer normal Super BTN_LEFT move-view

# Super + Right Mouse Button to resize views
riverctl map-pointer normal Super BTN_RIGHT resize-view

# Super + Middle Mouse Button to toggle float
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

for i in $(seq 1 9)
do
    tags=$((1 << (i - 1)))

    # Super+[1-9] to focus tag [0-8]
    riverctl map normal Super "$i" set-focused-tags "$tags"

    # Super+Shift+[1-9] to tag focused view with tag [0-8]
    riverctl map normal Super+Shift "$i" set-view-tags "$tags"

    # Super+Control+[1-9] to toggle focus of tag [0-8]
    riverctl map normal Super+Control "$i" toggle-focused-tags "$tags"

    # Super+Shift+Control+[1-9] to toggle tag [0-8] of focused view
    riverctl map normal Super+Shift+Control "$i" toggle-view-tags "$tags"
done

# Super+0 to focus all normal tags (excluding the scratchpad tag)
# Super+Shift+0 to tag focused view with all normal tags
# Super+grave / Super+Shift+grave for scratchpad tag (bit 20)
scratch_tag=$((1 << 20))
all_tags=$(((1 << 20) - 1))
riverctl map normal Super 0 set-focused-tags $all_tags
riverctl map normal Super+Shift 0 set-view-tags $all_tags
riverctl map normal Super grave toggle-focused-tags $scratch_tag
riverctl map normal Super+Shift grave set-view-tags $scratch_tag

# Super+Shift+F to toggle float
riverctl map normal Super+Shift F toggle-float

# Super+F to toggle fullscreen
riverctl map normal Super F toggle-fullscreen

# Super+{Up,Right,Down,Left} to change layout orientation
riverctl map normal Super Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Super Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super Left  send-layout-cmd rivertile "main-location left"

# Passthrough mode has a single mapping back to normal mode, for nested
# compositors.
riverctl declare-mode passthrough

# Super+F11 to enter passthrough mode
riverctl map normal Super F11 enter-mode passthrough

# Super+F11 to return to normal mode
riverctl map passthrough Super F11 enter-mode normal

# Media keys, also active on the lock screen. Volume and brightness changes
# are echoed to wob for an on-screen bar.
for mode in normal locked
do
    # Remove River's defaults first so reloads do not emit overwrite warnings.
    for key in XF86Eject \
               XF86AudioRaiseVolume XF86AudioLowerVolume XF86AudioMute XF86AudioMicMute \
               XF86AudioMedia XF86AudioPlay XF86AudioPrev XF86AudioNext \
               XF86MonBrightnessUp XF86MonBrightnessDown
    do
        riverctl unmap "$mode" None "$key" 2>/dev/null || true
    done

    # Eject the optical drive
    riverctl map "$mode" None XF86Eject spawn 'eject -T'

    # Control pulse audio volume with pamixer (https://github.com/cdemoulins/pamixer)
    riverctl map "$mode" None XF86AudioRaiseVolume spawn "pamixer -i 5 && pamixer --get-volume > \"\$XDG_RUNTIME_DIR/wob.sock\"; $bar_signal"
    riverctl map "$mode" None XF86AudioLowerVolume spawn "pamixer -d 5 && pamixer --get-volume > \"\$XDG_RUNTIME_DIR/wob.sock\"; $bar_signal"
    riverctl map "$mode" None XF86AudioMute spawn "pamixer --toggle-mute && if [ \"\$(pamixer --get-mute)\" = true ]; then printf '0\n'; else pamixer --get-volume; fi > \"\$XDG_RUNTIME_DIR/wob.sock\"; $bar_signal"
    riverctl map "$mode" None XF86AudioMicMute spawn "pamixer --default-source --toggle-mute && if [ \"\$(pamixer --default-source --get-mute)\" = true ]; then printf '0\n'; else pamixer --default-source --get-volume; fi > \"\$XDG_RUNTIME_DIR/wob.sock\"; $bar_signal"

    # Control MPRIS aware media players with playerctl (https://github.com/altdesktop/playerctl)
    riverctl map "$mode" None XF86AudioMedia spawn 'playerctl play-pause'
    riverctl map "$mode" None XF86AudioPlay spawn 'playerctl play-pause'
    riverctl map "$mode" None XF86AudioPrev spawn 'playerctl previous'
    riverctl map "$mode" None XF86AudioNext spawn 'playerctl next'

    # Control screen backlight brightness with brightnessctl (https://github.com/Hummer12007/brightnessctl)
    riverctl map "$mode" None XF86MonBrightnessUp spawn "brightnessctl -m set +2.5% | cut -d, -f4 | tr -d '%' > \"\$XDG_RUNTIME_DIR/wob.sock\""
    riverctl map "$mode" None XF86MonBrightnessDown spawn "brightnessctl -m set 2.5%- | cut -d, -f4 | tr -d '%' > \"\$XDG_RUNTIME_DIR/wob.sock\""
done

# Set background and border color
riverctl border-width "$BORDER_WIDTH"
riverctl background-color "$BACKGROUND_COLOR"
riverctl border-color-focused "$BORDER_FOCUSED"
riverctl border-color-unfocused "$BORDER_UNFOCUSED"

# Set keyboard repeat rate
riverctl set-repeat 35 300

# Each rule is deleted before it is added so reloads do not stack duplicates.
#
# Tags are assigned by app, leaving 6-9 free:
#   1  Emacs
#   2  agent sessions (app-id "agent", set by agent-session)
#   3  browser
#   4  reading
#   5  music and messaging
riverctl rule-del -app-id "emacs" tags 2>/dev/null || true
riverctl rule-del -app-id "agent" tags 2>/dev/null || true
riverctl rule-del -app-id "firefox" tags 2>/dev/null || true
riverctl rule-del -app-id "sioyek" tags 2>/dev/null || true
riverctl rule-add -app-id "emacs" tags $((1 << 0))
riverctl rule-add -app-id "agent" tags $((1 << 1))
riverctl rule-add -app-id "firefox" tags $((1 << 2))
riverctl rule-add -app-id "sioyek" tags $((1 << 3))

# Some apps use different app-ids under Wayland and XWayland, so both are
# listed; a non-matching rule is silently inert. Check with `lswt`.
for app in slack spotify org.telegram.desktop telegram-desktop \
           com.github.dagmoller.whatsapp-electron vesktop
do
    riverctl rule-del -app-id "$app" tags 2>/dev/null || true
    riverctl rule-add -app-id "$app" tags $((1 << 4))
done

# Every Zoom window shares the app-id "zoom" under XWayland. Float them all
# (toasts, toolbars, dialogs), then tile the main and meeting windows back in;
# the more specific title rules win.
riverctl rule-del -app-id "zoom" float 2>/dev/null || true
riverctl rule-add -app-id "zoom" float
for title in "Zoom Workplace*" "Zoom Meeting" "Meeting" "Zoom - *"
do
    riverctl rule-del -app-id "zoom" -title "$title" no-float 2>/dev/null || true
    riverctl rule-add -app-id "zoom" -title "$title" no-float
done

# Browser-side call helpers: the screen-sharing indicator and
# picture-in-picture video.
for title in "*Sharing Indicator" "Picture-in-Picture"
do
    riverctl rule-del -app-id "firefox" -title "$title" float 2>/dev/null || true
    riverctl rule-add -app-id "firefox" -title "$title" float
done

# Floating Org quick-capture popup frame (spawned by org-capture-quick).
riverctl rule-del -app-id "emacs" -title "org-capture" float 2>/dev/null || true
riverctl rule-add -app-id "emacs" -title "org-capture" float

# Consistent decorations
riverctl rule-del ssd 2>/dev/null || true
riverctl rule-add ssd

# The layout generator itself belongs to the one-time init script.
riverctl default-layout rivertile
