#!/bin/sh

# Open an agent terminal: a tmux session per project, so agents survive the
# window closing. With no argument, pick from running sessions and projects
# without one in fuzzel. The app-id "agent" lets River tag the window.

# shellcheck source=/dev/null
. "${XDG_CONFIG_HOME:-$HOME/.config}/scripts/projects.sh"

if [ "$#" -gt 1 ]; then
    printf 'usage: agent-session [project-directory]\n' >&2
    exit 2
fi

# Called from Emacs with the current project.
if [ "$#" -eq 1 ]; then
    target=$1
    if [ ! -d "$target" ]; then
        printf 'agent-session: not a directory: %s\n' "$target" >&2
        exit 1
    fi

    exec footclient --app-id=agent -e tmux new-session -A \
         -s "$(session_name "$target")" -c "$target"
fi

running=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)

menu=$(
    printf '%s\n' "$running" | sed '/^$/d; s/^/attach: /'

    project_list |
        while read -r dir; do
            name=$(session_name "$dir")
            printf '%s\n' "$running" | grep -qx "$name" || printf 'new: %s\n' "$dir"
        done
)

[ -n "$menu" ] || exit 0

choice=$(printf '%s\n' "$menu" | fuzzel --dmenu -w 60 --prompt 'agent> ') || exit 0
[ -n "$choice" ] || exit 0

target=${choice#*: }

case "$choice" in
    attach:*)
        # -A recreates a session that exited after it was listed.
        exec footclient --app-id=agent -e tmux new-session -A -s "$target"
        ;;
    new:*)
        exec footclient --app-id=agent -e tmux new-session -A \
             -s "$(session_name "$target")" -c "$target"
        ;;
esac
