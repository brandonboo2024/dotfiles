#!/bin/sh

# Pick a PDF or EPUB under the current directory in a tmux popup and open it.

select="$(
  fd -I -e pdf -e epub --strip-cwd-prefix . |
    sk --tmux center,80%
)" || exit 0

[ -n "$select" ] || exit 0

filepath="$PWD/$select"

setsid -f sioyek "$filepath" >/tmp/sioyek.log 2>&1 </dev/null
