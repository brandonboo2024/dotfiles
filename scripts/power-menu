#!/bin/sh

# Lock, reboot or shut down, chosen in fuzzel.

choice=$(
    printf '%s\n' "Lock" "Reboot" "Shutdown" |
        fuzzel --dmenu --minimal-lines
)

case "$choice" in
    Lock)
        lock-screen
        ;;
    Shutdown)
        systemctl poweroff
        ;;
    Reboot)
        systemctl reboot
        ;;
esac
