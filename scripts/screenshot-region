#!/bin/sh
# Drag out a region. See screenshot-full for the whole screen.

dir="${SCREENSHOT_DIR:-$HOME/screenshots}"
mkdir -p "$dir"

geometry=$(slurp) || exit 0
file="$dir/$(date +%Y%m%d_%H%M%S).png"

if ! grim -g "$geometry" "$file"; then
    notify-send -u critical "Screenshot capture failed"
    exit 1
fi

if ! wl-copy --type image/png < "$file"; then
    notify-send -u critical "Screenshot saved, clipboard copy failed"
    exit 1
fi

notify-send "Screenshot saved and copied"
