#!/bin/sh

# Switch the tmux client to a project's session, creating it if needed.
# Pick the project with fzf, or pass a directory (used by tmux.conf bindings).

# shellcheck source=/dev/null
. "${XDG_CONFIG_HOME:-$HOME/.config}/scripts/projects.sh"

if [ "$#" -eq 1 ]; then
    selected=$1
else
    selected=$(project_list | sed "s#^$HOME/##" | fzf --tmux center,80%) || exit 0
    [ -n "$selected" ] || exit 0
    selected="$HOME/$selected"
fi

[ -n "$selected" ] || exit 0

selected_name=$(session_name "$selected")

# -A creates the session only if it does not exist, atomically.
tmux new-session -d -A -s "$selected_name" -c "$selected"
tmux switch-client -t "$selected_name"
