#!/bin/sh

# Status line for creek, one line per tick. $BAR_MODULES (set per host in
# river/) picks the modules and their order.
#
# /proc and /sys are read with builtins to avoid forks. Volume refreshes on
# SIGUSR1 and every $BAR_VOL_EVERY ticks; network and bluetooth refresh on
# SIGUSR1 and every $BAR_SLOW_EVERY ticks. Modules assign to $out instead of
# printing, because a command substitution would run them in a subshell and
# lose their state.

: "${BAR_MODULES:=cpu ram bat vol net bt clock}"
: "${BAR_INTERVAL:=2}"
: "${BAR_VOL_EVERY:=5}"
: "${BAR_SLOW_EVERY:=30}"

: "${BAR_PIDFILE:=${XDG_RUNTIME_DIR:-/tmp}/status-bar.pid}"
pidfile="$BAR_PIDFILE"
sleep_pid=""
refresh=0

cleanup() {
    [ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null || true
    rm -f "$pidfile"
}

trap cleanup EXIT
trap 'exit 0' INT TERM HUP PIPE
trap 'refresh=1; [ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null || true' USR1
printf '%s\n' "$$" > "$pidfile"

# ─── CPU ────────────────────────────────────────────
# Usage since the previous tick; primed once before the loop.
prev_idle=0
prev_total=0
cpu_cache="CPU:0%"

cpu_refresh() {
    read -r _ user nice sys idle iowait irq softirq _ < /proc/stat
    total=$((user + nice + sys + idle + iowait + irq + softirq))

    d_total=$((total - prev_total))
    d_idle=$((idle - prev_idle))
    prev_total=$total
    prev_idle=$idle

    if [ "$d_total" -gt 0 ]; then
        cpu_cache="CPU:$(((100 * (d_total - d_idle)) / d_total))%"
    else
        cpu_cache="CPU:0%"
    fi
}

cpu_module() { out="$cpu_cache"; }

# ─── Memory ─────────────────────────────────────────
# Used = total - available, printed in GiB with one decimal.
ram_module() {
    mem_total=0
    mem_avail=0
    while read -r key value _; do
        case "$key" in
            MemTotal:)     mem_total=$value ;;
            MemAvailable:) mem_avail=$value; break ;;
        esac
    done < /proc/meminfo

    used_mib=$(((mem_total - mem_avail) / 1024))
    out="RAM:$((used_mib / 1024)).$(((used_mib % 1024) * 10 / 1024))G"
}

# ─── Battery ────────────────────────────────────────
# Empty when there is no battery, so the field is omitted.
bat_module() {
    out=""
    for bat in /sys/class/power_supply/BAT*; do
        [ -r "$bat/capacity" ] || continue
        read -r capacity < "$bat/capacity"
        status=""
        [ -r "$bat/status" ] && read -r status < "$bat/status"
        case "$status" in
            Charging*)            icon="+" ;;
            Discharging*)         icon="-" ;;
            Full*|"Not charging") icon="=" ;;
            *)                    icon="?" ;;
        esac
        out="BAT:$icon$capacity%"
        return
    done
}

# ─── Volume ─────────────────────────────────────────
vol_cache="VOL:?"

vol_refresh() {
    vol=$(pamixer --get-volume-human 2>/dev/null)
    if [ "$vol" = "muted" ]; then
        vol_cache="VOL:MUTE"
    else
        vol_cache="VOL:${vol:-?}"
    fi
}

vol_module() { out="$vol_cache"; }

# ─── Network (slow) ─────────────────────────────────
# Uses the default-route interface, so docker bridges and veths are ignored.
net_cache="offline"

net_refresh() {
    net_cache="offline"
    while read -r iface dest _; do
        [ "$dest" = "00000000" ] || continue
        if [ -d "/sys/class/net/$iface/wireless" ]; then
            ssid=$(nmcli -t -f active,ssid dev wifi list --rescan no 2>/dev/null |
                       sed -n 's/^yes://p' | head -n 1)
            net_cache="${ssid:-wifi}"
        else
            net_cache="eth"
        fi
        return
    done < /proc/net/route
}

net_module() { out="$net_cache"; }

# ─── Bluetooth (slow) ───────────────────────────────
bt_cache="BT:off"

bt_refresh() {
    if ! command -v bluetoothctl >/dev/null 2>&1; then
        bt_cache="BT:N/A"
        return
    fi

    powered=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')
    if [ "$powered" != "yes" ]; then
        bt_cache="BT:off"
        return
    fi

    connected=$(bluetoothctl devices Connected 2>/dev/null | head -n 1 | cut -d' ' -f3-)
    bt_cache="BT:${connected:-on}"
}

bt_module() { out="$bt_cache"; }

# ─── Clock ──────────────────────────────────────────
clock_module() {
    out=$(date '+%a %b %d %H:%M')
}

# ─── Main loop ──────────────────────────────────────
# Prime CPU counters before the first tick; slow modules refresh at tick=0.
case " $BAR_MODULES " in *" cpu "*) cpu_refresh ;; esac
tick=0

while true; do
    was_refresh=$refresh
    refresh=0

    # Sample CPU only on regular timer expirations so early USR1 wakes do not
    # produce noisy sub-second readings.
    if [ "$was_refresh" -eq 0 ] && [ "$tick" -gt 0 ]; then
        case " $BAR_MODULES " in *" cpu "*) cpu_refresh ;; esac
    fi

    if [ "$tick" -eq 0 ] || [ "$was_refresh" -eq 1 ] || [ "$((tick % BAR_VOL_EVERY))" -eq 0 ]; then
        case " $BAR_MODULES " in *" vol "*) vol_refresh ;; esac
    fi

    if [ "$tick" -eq 0 ] || [ "$was_refresh" -eq 1 ] || [ "$((tick % BAR_SLOW_EVERY))" -eq 0 ]; then
        case " $BAR_MODULES " in *" net "*) net_refresh ;; esac
        case " $BAR_MODULES " in *" bt "*)  bt_refresh  ;; esac
    fi

    [ "$was_refresh" -eq 0 ] && tick=$((tick + 1))

    line=""
    for module in $BAR_MODULES; do
        command -v "${module}_module" >/dev/null 2>&1 || continue
        out=""
        "${module}_module"
        [ -n "$out" ] || continue
        if [ -n "$line" ]; then
            line="$line | $out"
        else
            line="$out"
        fi
    done

    printf '%s\n' "$line" || exit 0

    if [ "$refresh" -eq 0 ]; then
        sleep "$BAR_INTERVAL" &
        sleep_pid=$!
        wait "$sleep_pid" 2>/dev/null || true
        sleep_pid=""
    fi
done
