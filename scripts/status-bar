#!/bin/sh

# Status line for creek: one line per tick on stdout.
#
# Which modules appear, and in what order, is $BAR_MODULES. River exports it
# from river/hosts/<hostname>.sh, so a machine takes only what it has -- there
# is no point printing a battery on the desktop.
#
# Everything available from /proc or /sys is read with shell builtins and no
# subprocesses. The two modules that genuinely need a helper program, network
# name and bluetooth, describe things that change on the timescale of minutes,
# so they refresh every $BAR_SLOW_EVERY ticks and are cached in between. An
# ordinary tick costs two forks, pamixer and date; the previous version
# measured at roughly forty.
#
# Each module assigns to $out rather than printing. That is deliberate: a
# command substitution would run the module in a subshell, and the CPU and
# cache variables would not survive between ticks.

: "${BAR_MODULES:=cpu ram bat vol net bt clock}"
: "${BAR_INTERVAL:=2}"
: "${BAR_SLOW_EVERY:=30}"

# ─── CPU ────────────────────────────────────────────
# Usage is the delta between ticks, so the module holds no sleep of its own
# and the loop period really is $BAR_INTERVAL. The priming call before the
# loop gives the first real tick something to compare against.
prev_idle=0
prev_total=0

cpu_module() {
    read -r _ user nice sys idle iowait irq softirq _ < /proc/stat
    total=$((user + nice + sys + idle + iowait + irq + softirq))

    d_total=$((total - prev_total))
    d_idle=$((idle - prev_idle))
    prev_total=$total
    prev_idle=$idle

    if [ "$d_total" -gt 0 ]; then
        out="CPU:$(((100 * (d_total - d_idle)) / d_total))%"
    else
        out="CPU:0%"
    fi
}

# ─── Memory ─────────────────────────────────────────
# Used is total minus available, which is what "how much is left for me"
# actually means. Integer arithmetic only, so the decimal is done by hand.
ram_module() {
    mem_total=0
    mem_avail=0
    while read -r key value _; do
        case "$key" in
            MemTotal:)     mem_total=$value ;;
            MemAvailable:) mem_avail=$value; break ;;
        esac
    done < /proc/meminfo

    used_mib=$(((mem_total - mem_avail) / 1024))
    out="RAM:$((used_mib / 1024)).$(((used_mib % 1024) * 10 / 1024))G"
}

# ─── Battery ────────────────────────────────────────
# Produces nothing when there is no battery, so a machine that lists this
# module but has none simply omits the field instead of showing "N/A".
battery_module() {
    out=""
    for bat in /sys/class/power_supply/BAT*; do
        [ -r "$bat/capacity" ] || continue
        read -r capacity < "$bat/capacity"
        status=""
        [ -r "$bat/status" ] && read -r status < "$bat/status"
        case "$status" in
            Charging*)            icon="+" ;;
            Discharging*)         icon="-" ;;
            Full*|"Not charging") icon="=" ;;
            *)                    icon="?" ;;
        esac
        out="BAT:$icon$capacity%"
        return
    done
}

bat_module() { battery_module; }

# ─── Volume ─────────────────────────────────────────
vol_module() {
    if [ "$(pamixer --get-mute 2>/dev/null)" = "true" ]; then
        out="VOL:MUTE"
    else
        out="VOL:$(pamixer --get-volume 2>/dev/null)%"
    fi
}

# ─── Network (slow) ─────────────────────────────────
# Link state comes from sysfs, but the network's name needs nmcli, so the
# whole module is refreshed only on a slow tick.
net_cache="NET:off"

net_refresh() {
    for dev in /sys/class/net/*; do
        name=${dev##*/}
        [ "$name" = "lo" ] && continue
        [ -r "$dev/operstate" ] || continue
        read -r state < "$dev/operstate"
        [ "$state" = "up" ] || continue

        if [ -d "$dev/wireless" ]; then
            ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null |
                       sed -n 's/^yes://p' | head -n 1)
            net_cache="NET:${ssid:-wifi}"
        else
            net_cache="NET:eth"
        fi
        return
    done
    net_cache="NET:off"
}

net_module() { out="$net_cache"; }

# ─── Bluetooth (slow) ───────────────────────────────
bt_cache="BT:off"

bt_refresh() {
    if ! command -v bluetoothctl >/dev/null 2>&1; then
        bt_cache="BT:N/A"
        return
    fi

    powered=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')
    if [ "$powered" != "yes" ]; then
        bt_cache="BT:off"
        return
    fi

    connected=$(bluetoothctl devices Connected 2>/dev/null | head -n 1 | cut -d' ' -f3-)
    bt_cache="BT:${connected:-on}"
}

bt_module() { out="$bt_cache"; }

# ─── Clock ──────────────────────────────────────────
clock_module() {
    out=$(date '+%a %b %d %H:%M')
}

# ─── Main loop ──────────────────────────────────────
cpu_module          # prime the CPU delta
net_refresh
bt_refresh
tick=0

while true; do
    if [ "$((tick % BAR_SLOW_EVERY))" -eq 0 ]; then
        case " $BAR_MODULES " in *" net "*) net_refresh ;; esac
        case " $BAR_MODULES " in *" bt "*)  bt_refresh  ;; esac
    fi
    tick=$((tick + 1))

    line=""
    for module in $BAR_MODULES; do
        command -v "${module}_module" >/dev/null 2>&1 || continue
        out=""
        "${module}_module"
        [ -n "$out" ] || continue
        if [ -n "$line" ]; then
            line="$line | $out"
        else
            line="$out"
        fi
    done

    printf '%s\n' "$line"
    sleep "$BAR_INTERVAL"
done
