#!/bin/sh

# Pick a PDF or EPUB (Sioyek recents first, then reading and school folders)
# and open it in sioyek.

recent_pdfs() {
    command -v python3 >/dev/null 2>&1 || return 0
    data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/sioyek"
    [ -r "$data_dir/shared.db" ] && [ -r "$data_dir/local.db" ] || return 0
    python3 - "$data_dir/shared.db" "$data_dir/local.db" 2>/dev/null <<'PY' || true
import os, sqlite3, sys

shared_db, local_db = sys.argv[1], sys.argv[2]
con = sqlite3.connect(f"file:{shared_db}?mode=ro", uri=True, timeout=0.5)
con.execute("ATTACH DATABASE ? AS loc", (f"file:{local_db}?mode=ro",))
for (path,) in con.execute(
    "SELECT loc.document_hash.path "
    "FROM opened_books "
    "JOIN loc.document_hash ON opened_books.path = loc.document_hash.hash "
    "ORDER BY opened_books.last_access_time DESC"
):
    if path and os.path.isfile(path):
        print(path)
PY
}

filepath="$(
    {
        recent_pdfs
        fd -a -I -e pdf -e epub --full-path . \
            "$HOME/200_reading/" \
            "$HOME/101_school_materials/" 2>/dev/null
    } |
    awk '!seen[$0]++' |
    while IFS= read -r path; do
        printf '%s\t%s\n' "$path" "${path##*/}"
    done |
    fuzzel --dmenu --with-nth=2 --accept-nth=1 --only-match -w 50
)" || exit 0

[ -n "$filepath" ] || exit 0

setsid -f sioyek "$filepath" >/tmp/sioyek.log 2>&1 </dev/null
