# Battery-powered default; Hephaestus uses config.Hephaestus (no suspend).
# Events are only defined here: command-line events would add to these.

timeout 300 "notify-send 'Locking in 10 seconds...'"
timeout 310 "lock-screen"
timeout 900 "systemctl suspend"

# Also lock on any suspend and on `loginctl lock-session`, not just on idle.
before-sleep "lock-screen"
lock "lock-screen"
